<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="classes.GameController">
    <children>
        <!-- Background Decorations -->
        <Label rotate="-20.0" styleClass="math-symbol" text="+" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="30.0" />
        <Label rotate="15.0" styleClass="math-symbol" text="×" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="50.0" />
        <Label rotate="10.0" styleClass="math-symbol" text="÷" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="50.0" />
        <Label rotate="-15.0" styleClass="math-symbol" text="-" AnchorPane.bottomAnchor="50.0" AnchorPane.rightAnchor="40.0" />

        <VBox alignment="CENTER" spacing="20.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Label fx:id="scoreLabel" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Score: 0" />
            </HBox>
            <StackPane prefHeight="150.0" prefWidth="200.0">
                <Circle fill="TRANSPARENT" radius="80" stroke="e0e0e0" strokeWidth="15" />
                <Group>
                    <Circle fill="TRANSPARENT" radius="110" stroke="TRANSPARENT" />
                    <Arc fx:id="timerArc" fill="TRANSPARENT" length="360" radiusX="80" radiusY="80" startAngle="90" stroke="#46178f" strokeLineCap="ROUND" strokeWidth="15" type="OPEN" />
                </Group>
                <Label fx:id="timerLabel" style="-fx-font-size: 40px; -fx-font-weight: bold; -fx-text-fill: #333;" text="10" />
            </StackPane>
            <ScrollPane prefHeight="200.0" prefWidth="760.0">
                <content>
                    <VBox fx:id="questionBox" alignment="CENTER" prefHeight="113.0" prefWidth="744.0" style="-fx-font-size: 48;">
                  <children>
                            <Label fx:id="questionLabel" alignment="CENTER" contentDisplay="CENTER" pickOnBounds="false" prefHeight="70.0" prefWidth="648.0" text="Ready?" />
                  </children>
                    </VBox>
                </content>
            </ScrollPane>

            <GridPane alignment="CENTER" hgap="15" vgap="15">
                <Button fx:id="btn1" prefHeight="100" prefWidth="250" styleClass="btn, btn-danger, btn-lg" text="Option A" GridPane.columnIndex="0" GridPane.rowIndex="0" />

                <Button fx:id="btn2" prefHeight="100" prefWidth="250" styleClass="btn, btn-primary, btn-lg" text="Option B" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Button fx:id="btn3" prefHeight="100" prefWidth="250" styleClass="btn, btn-warning, btn-lg" text="Option C" GridPane.columnIndex="0" GridPane.rowIndex="1" />

                <Button fx:id="btn4" prefHeight="100" prefWidth="250" styleClass="btn, btn-success, btn-lg" text="Option D" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <columnConstraints>
                    <ColumnConstraints />
                    <ColumnConstraints />
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
            </GridPane>

            <Button fx:id="restartBtn" managed="false" style="-fx-font-weight: bold; -fx-padding: 10 30 10 30;" styleClass="btn, btn-info, btn-lg" text="PLAY AGAIN" visible="false" />
        </VBox>
    </children>
</AnchorPane>
