<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane fx:id="rootPane" prefHeight="600.0" prefWidth="800.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23" xmlns:fx="http://javafx.com/fxml/1" fx:controller="classes.LeaderBoardController">
   <children>
      <!-- Background Decorations -->
      <Label rotate="-20.0" styleClass="math-symbol" text="+" AnchorPane.leftAnchor="30.0" AnchorPane.topAnchor="30.0" />
      <Label rotate="15.0" styleClass="math-symbol" text="×" AnchorPane.rightAnchor="30.0" AnchorPane.topAnchor="50.0" />
      <Label rotate="10.0" styleClass="math-symbol" text="÷" AnchorPane.bottomAnchor="30.0" AnchorPane.leftAnchor="50.0" />
      <Label rotate="-15.0" styleClass="math-symbol" text="-" AnchorPane.bottomAnchor="50.0" AnchorPane.rightAnchor="40.0" />

      <StackPane layoutX="100.0" layoutY="45.0" styleClass="title-banner" AnchorPane.leftAnchor="100.0" AnchorPane.rightAnchor="100.0" AnchorPane.topAnchor="45.0">
         <children>
            <Label styleClass="leaderboard-title" text="🏆LEADERBOARD🏆" />
         </children>
      </StackPane>

      <ScrollPane fitToWidth="true" layoutY="166.4" prefHeight="354.0" prefWidth="720.0" styleClass="scroll-pane" AnchorPane.bottomAnchor="80.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="166.0">
         <content>
            <VBox fx:id="leaderboardBox" alignment="CENTER" spacing="10.0" />
         </content>
      </ScrollPane>

      <StackPane fx:id="loadingLayer" visible="false" AnchorPane.bottomAnchor="80.0" AnchorPane.leftAnchor="40.0" AnchorPane.rightAnchor="40.0" AnchorPane.topAnchor="120.0">
         <children>
            <VBox alignment="CENTER" spacing="15.0" styleClass="loading-box">
               <children>
                  <Label fx:id="loadingSpinner" style="-fx-font-size: 60px;" styleClass="loading-text" text="⏳" />
                  <Label styleClass="loading-text" text="LOADING SCORES..." />
               </children>
            </VBox>
         </children>
      </StackPane>

      <Button fx:id="backBtn" layoutX="348.0" layoutY="526.0" mnemonicParsing="false" onAction="#exitLeaderboard" prefHeight="54.0" prefWidth="103.0" styleClass="game-button" text="BACK" AnchorPane.bottomAnchor="19.600000000000023" AnchorPane.rightAnchor="348.8" />
   </children>
</AnchorPane>
